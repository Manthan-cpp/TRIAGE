# Meta Model API Key (Muse Spark, SAM 3.1)
META_MODEL_API_KEY=your_meta_model_api_key_here
META_MODEL_API_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1
MUSE_MODEL=muse-spark-1.3
SAM_ENDPOINT=/responses
MUSE_ENDPOINT=/chat/completions
SAM_ESTIMATED_COST_USD=0.005
MUSE_ESTIMATED_COST_USD=0.002
META_REQUEST_TIMEOUT_MS=45000
META_MAX_RETRIES=2

# Backend Service Config
PORT=4000
NODE_ENV=development

# Storage paths
DATA_DIR=./data
DATABASE_PATH=./data/triage.db
VIDEO_FPS=1
MAX_IMAGE_DIMENSION=800
JPEG_QUALITY=85
PERCEPTION_CONCURRENCY=3
RANKING_BATCH_SIZE=10
MAX_IMAGE_SIZE_MB=25
MAX_VIDEO_SIZE_MB=150
MAX_UPLOAD_FILE_MB=150
MAX_UPLOAD_FILES=50
MAX_COMBINED_UPLOAD_MB=500
MAX_REQUEST_FIELD_MB=1

# Frontend Config
# Leave empty when the frontend is served by the backend. Set this to the
# deployed backend origin when hosting the frontend separately.
VITE_API_BASE_URL=
# Local Vite proxy target (used only by frontend/vite.config.ts).
# Set this to the backend origin when running the frontend separately.
VITE_DEV_API_PROXY_TARGET=
